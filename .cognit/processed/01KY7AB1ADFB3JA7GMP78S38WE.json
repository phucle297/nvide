ecomes clearly superior later,\",\n)\n\n# Shell diagram AI\nhtml = html.replace(\n    \"│  AI      │   └──────────────┴──────────────────┘                   │\",\n    \"│  Ext     │   └──────────────┴──────────────────┘                   │\",\n)\n# might create duplicate Ext - check\n# Original had Ext on next line - let me read... \"│  Ext     │\" might now duplicate\n# Looking at original:\n# │  AI      │   └──────────────┴──────────────────┘                   │\n# │  Ext     ├─────────────────────────────────────────────────────────┤\n# After replace both say Ext - fix second to keep Ext only once in activity bar\nhtml = html.replace(\n    \"│  Ext     │   └──────────────┴──────────────────┘                   │\\n│  Ext     ├─────────────────────────────────────────────────────────┤\",\n    \"│          │   └──────────────┴──────────────────┘                   │\\n│  Ext     ├─────────────────────────────────────────────────────────┤\",\n)\n\nhtml = html.replace(\n    \"│          │ Status: mode · branch · LSP · AI · cursor · encoding    │\",\n    \"│          │ Status: mode · branch · LSP · cursor · encoding         │\",\n)\nhtml = re.sub(\n    r'\\s*<tr><td>AI panel</td><td>Chat, agents, plans, cost</td><td><a href=\"#ai\">AI</a> · <a href=\"#adr-0010\">ADR-0010</a></td></tr>',\n    '',\n    html,\n)\n\n# extmarks AI suggestions\nhtml = html.replace(\n    \"coverage, AI suggestions, inlay hints\",\n    \"coverage, inlay hints\",\n)\n\n# plugin permission ai\nhtml = re.sub(\n    r'\\s*<tr><td><code>ai</code></td><td>Invoke AI / tools</td><td>Prompt</td></tr>',\n    '',\n    html,\n)\n\n# terminal decade\nhtml = html.replace(\n    \"Correct terminal emulation is a decade of edge cases;\",\n    \"Correct terminal emulation is years of edge cases;\",\n)\n\n# git AI assist\nhtml = html.replace(\n    \"CodeLens accept ours/theirs; AI assist optional.\",\n    \"CodeLens accept ours/theirs.\",\n)\n\n# remote\nhtml = html.replace(\n    \"Decision: Local UI + local core orchestrator + remote agent for FS/PTY/LSP/Git/AI tools\",\n    \"Decision: Local UI + local core orchestrator + remote agent for FS/PTY/LSP/Git tools\",\n)\nhtml = html.replace(\n    \"      <li><code>ai.tools.*</code> — execute tool on remote (tests, builds).</li>\\n\",\n    \"      <li><code>task.*</code> — run builds/tests on remote when requested.</li>\\n\",\n)\n\n# security\nhtml = html.replace(\n    \"      <li>Secret leakage to AI providers.</li>\\n\",\n    \"\",\n)\n\n# performance\nhtml = html.replace(\n    \"Lazy load plugins; defer AI index; compact binary; avoid huge static init\",\n    \"Lazy load plugins; compact binary; avoid huge static init\",\n)\n\n# settings schema example\nhtml = re.sub(\n    r'\\n  \"ai\\.provider\": \"openai-compatible\",\\n  \"ai\\.budgetMonthlyUsd\": 20,',\n    '',\n    html,\n)\n\n# MVP\nhtml = html.replace(\n    \"      <li>AI: chat + context from open files/diagnostics + apply patch with approval (single provider pluggable).</li>\\n\",\n    \"\",\n)\nhtml = html.replace(\n    \"      <li>Built-in merge conflict AI auto-resolve.</li>\\n\",\n    \"      <li>Built-in automated merge conflict resolution.</li>\\n\",\n)\nhtml = html.replace(\n    \"      <li>AI agent multi-step tools + local models.</li>\\n\",\n    \"\",\n)\n\n# Phase 4 remote+AI\nhtml = html.replace(\n    \"Phase 4 — Remote + AI MVP (Beta 2)\",\n    \"Phase 4 — Remote Development (Beta 2)\",\n)\nhtml = html.replace(\n    \"      <li>AI host: index v0, chat, apply patch, permissions, cost meter.</li>\\n\",\n    \"\",\n)\nhtml = html.replace(\n    \"      <li>AI apply-patch workflow used weekly by team.</li>\\n\",\n    \"      <li>SSH remote used weekly by team for real work.</li>\\n\",\n)\nhtml = html.replace(\n    \"      <li>AI provider volatility — keep providers pluggable.</li>\\n\",\n    \"\",\n)\nhtml = html.replace(\n    \"parallelization of remote/AI/plugins can compress toward ~12 months with higher headcount.\",\n    \"parallelization of remote/plugins can compress toward ~12 months with higher headcount.\",\n)\nhtml = html.replace(\n    \"      <li>Local model runtime first-class.</li>\\n\",\n    \"\",\n)\n\n# Years 4-10 -> longer horizon wording without \"10 years\"\nhtml = html.replace(\n    \"<h4>Years 4–10</h4>\",\n    \"<h4>Later expansion</h4>\",\n)\n\n# glossary\nhtml = html.replace(\n    \"<tr><td>Agent</td><td>Remote side binary OR AI agent (disambiguate by context)</td></tr>\",\n    \"<tr><td>Agent</td><td>Remote-side binary (<code>nvide-agent</code>) for FS/PTY/LSP/Git</td></tr>\",\n)\nhtml = html.replace(\n    \"Product evolution stage (MVP, 1.0, 2.0, Enterprise, Cloud, AI-native)\",\n    \"Product evolution stage (MVP, 1.0, 2.0, Enterprise, Cloud)\",\n)\n\n# Footer decade\nhtml = html.replace(\n    \"This document is the architecture baseline for a 10-year native Rust IDE.\",\n    \"This document is the architecture baseline for the NVide native Rust IDE.\",\n)\n\n# Comment in important callout if any decade\n# meta description\nhtml = html.replace(\n    'content=\"NVide — Native Rust IDE Architecture Document. Enterprise-scale design for a next-generation developer environment.\"',\n    'content=\"NVide — Native Rust IDE Architecture Document.\"',\n)\n\n# ADR catalog version line in cover still mentions ADR-0020\nhtml = html.replace(\n    \"<div><dt>ADR Catalog Version</dt><dd>2026.07 (see catalog)</dd></div>\",\n    \"<div><dt>ADR Catalog Version</dt><dd>2026.07</dd></div>\",\n)\n\n# Phase 6 collab AI? already no\n# Cut debugger note about AI\n\n# Fix any remaining standalone AI references carefully\nremaining = []\nfor i, line in enumerate(html.splitlines(), 1):\n    # skip CSS false positives\n    if re.search(r'\\bAI\\b|ai-host|nvide-ai|ai\\.|/ai\\b|#ai\\b|AI-first|AI-First|AI-native|AI panel|AI host|AI path|AI tools|AI assist|AI chat|AI cost|AI provider|AI agent|AI index|AI suggestions|AI as |AI cloud|AI-augmented|openai|llm|LLM', line, re.I):\n        if 'details' in line.lower() and 'AI' not in line and 'ai' not in line:\n            continue\n        # filter false positives\n        low = line.lower()\n        if any(x in low for x in ['maintain', 'available', 'constraint', 'await', 'daily', 'main ', 'domain', 'detail', 'email', 'trail', 'pair', 'fair', 'said', 'again', 'container', 'paint', 'trait', 'failure', 'partial', 'campaign']):\n            # still check explicit AI tokens\n            if not re.search(r'\\bAI\\b|ai-host|nvide-ai|#ai\\b|ai\\.tools|openai|AI-first|AI-native|AI-First|adr-0010', line, re.I):\n                continue\n        remaining.append((i, line.strip()[:120]))\n\nprint(\"Remaining AI-ish lines:\", len(remaining))\nfor i, l in remaining[:40]:\n    print(f\"  {i}: {l}\")\n\npath.write_text(html, encoding=\"utf-8\")\nprint(\"wrote\", path.stat().st_size)\nPY"
