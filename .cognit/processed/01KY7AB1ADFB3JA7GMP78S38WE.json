.S,\n)\nprint(\"removed R-03:\", n)\n\n# Renumber risks R-04..R-10 to R-03..R-09 for cleanliness? Optional. I'll renumber.\nfor old, new in [\n    (\"R-04\", \"R-03\"),\n    (\"R-05\", \"R-04\"),\n    (\"R-06\", \"R-05\"),\n    (\"R-07\", \"R-06\"),\n    (\"R-08\", \"R-07\"),\n    (\"R-09\", \"R-08\"),\n    (\"R-10\", \"R-09\"),\n]:\n    # only in risk table context - replace all R-0X td\n    html = html.replace(f\"<td>{old}</td>\", f\"<td>{new}</td>\")\n\n# ========== 7. Ownership / deps - remove ai ==========\nhtml = html.replace(\n    \"core, syntax, search, ai (read APIs)\",\n    \"core, syntax, search\",\n)\nhtml = html.replace(\n    \"plugin-host, git, ai\",\n    \"plugin-host, git\",\n)\nhtml = re.sub(\n    r'\\s*<tr><td><code>nvide-ai</code></td><td>Internal</td><td>ai-host binary</td><td>render</td></tr>',\n    '',\n    html,\n)\nhtml = html.replace(\n    \"<code>nvide-ui</code> and <code>nvide-render</code> must never import plugin or AI host code.\",\n    \"<code>nvide-ui</code> and <code>nvide-render</code> must never import plugin host code.\",\n)\nhtml = html.replace(\n    \"│ lsp git ai │\",\n    \"│ lsp git    │\",\n)\nhtml = html.replace(\n    \"      <li><code>ai</code> → tools call core via NRPC, not by linking <code>nvide-ui</code>.</li>\\n\",\n    \"\",\n)\n\n# ========== 8. Memory ownership AI rows ==========\nhtml, n = re.subn(\n    r'\\s*<tr>\\s*'\n    r'<td>AI index segments</td>.*?</tr>',\n    '',\n    html,\n    count=1,\n    flags=re.S,\n)\nprint(\"removed AI memory row:\", n)\nhtml = html.replace(\n    \"for async consumers (LSP, AI), take versioned immutable snapshots\",\n    \"for async consumers (LSP, search), take versioned immutable snapshots\",\n)\nhtml = html.replace(\n    \"AI host dead; git host restarting\",\n    \"Git host restarting; lang host down\",\n)\n\n# ========== 9. Executive summary ==========\nhtml = html.replace(\n    \"      <li><strong>AI as infrastructure</strong> — indexing, agents, tool-calling, and permissions